{
  "description": "DataFog guard: replaces personal data and credentials with markers before the model sees them. Every entry fails closed where Claude Code allows it (onFailure: block).",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/datafog-guard\" session-start",
            "timeout": 300,
            "onFailure": "block",
            "statusMessage": "DataFog guard: checking protection"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/datafog-guard\" hook",
            "timeout": 30,
            "onFailure": "block"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/datafog-guard\" hook",
            "timeout": 60,
            "onFailure": "block"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/datafog-guard\" hook",
            "timeout": 60,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
