{
  "mcpServers": {
    "guard": {
      "command": "sh",
      "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/datafog-guard", "mcp"],
      "env": {
        "CLAUDE_PROJECT_DIR": "${CLAUDE_PROJECT_DIR}",
        "DATAFOG_DATA_DIR": "${DATAFOG_DATA_DIR:-}",
        "DATAFOG_VAULT_DIR": "${DATAFOG_VAULT_DIR:-}",
        "DATAFOG_VAULT_KEY": "${DATAFOG_VAULT_KEY:-}"
      }
    }
  }
}
